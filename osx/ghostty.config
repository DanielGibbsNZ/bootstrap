window-padding-x = 4

keybind = super+shift+arrow_left=previous_tab
keybind = super+shift+arrow_right=next_tab
keybind = super+arrow_left=goto_split:previous
keybind = super+arrow_right=goto_split:next

background = #000000
background-opacity = 0.9
background-blur = 5
theme = Github Dark Default
font-size = 14
font-thicken = true
font-thicken-strength = 0
adjust-cell-height = 1
shell-integration-features = no-cursor,ssh-env
macos-titlebar-style = native
window-inherit-working-directory = false
working-directory = home
cursor-invert-fg-bg = true
minimum-contrast = 1.05
window-new-tab-position = end
split-divider-color = #666
